  </action>
  <action id="caic-test-command">
    <description>Run the test command for CAIC.</description>
    <message>Enter the administrator password to run the test command for CAIC.</message>
    <icon_name>caic</icon_name>
    <defaults>
      <!-- auth_admin or yes -->
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
