    <icon_name>caic</icon_name>
    <defaults>
      <!-- auth_admin or yes -->
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/caic/commands/move-path</annotate>
  </action>
  <action id="caic-replace-text">
    <description>Replace text in a file for CAIC.</description>
    <message>Enter the administrator password to replace text in a file for CAIC.</message>
    <icon_name>caic</icon_name>
    <defaults>
      <!-- auth_admin or yes -->
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/caic/commands/replace-text</annotate>
  </action>
  <action id="caic-start-console">
    <description>Start the virtual environment for CAIC.</description>
    <message>Enter the administrator password to start the virtual environment for CAIC.</message>
    <icon_name>caic</icon_name>
    <defaults>
      <!-- auth_admin or yes -->
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/caic/commands/start-console</annotate>
  </action>
  <action id="caic-stop-console">
    <description>Stop the virtual environment for CAIC.</description>
    <message>Enter the administrator password to stop the virtual environment for CAIC.</message>
    <icon_name>caic</icon_name>
    <defaults>
      <!-- auth_admin or yes -->
      <allow_any>yes</allow_any>
