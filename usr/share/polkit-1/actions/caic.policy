    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/caic/commands/test-command</annotate>
  </action>
  <action id="caic-unmount-iso">
    <description>Unmount an ISO for CAIC.</description>
    <message>Enter the administrator password to unmount an ISO for CAIC.</message>
    <icon_name>caic</icon_name>
    <defaults>
      <!-- auth_admin or yes -->
